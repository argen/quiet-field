{
  "name": "quiet-field",
  "version": "0.1.0",
  "description": "A meditative new-tab gallery — procedural color fields in the spirit of Rothko.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Bruno Belcastro",
  "homepage": "https://github.com/argen/quiet-field#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/argen/quiet-field.git"
  },
  "bugs": {
    "url": "https://github.com/argen/quiet-field/issues"
  },
  "keywords": [
    "chrome-extension",
    "new-tab",
    "generative-art",
    "color-field",
    "rothko",
    "manifest-v3"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:publish": "tsc --noEmit && QF_PUBLISH=1 vite build && node scripts/prune-personal.mjs dist",
    "package:publish": "pnpm build:publish && rm -f quiet-field.zip && cd dist && zip -rq ../quiet-field.zip . && cd ..",
    "icons": "node scripts/make-icons.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "puppeteer": "^25.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^3.2.6"
  }
}
