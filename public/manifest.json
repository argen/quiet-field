{
  "manifest_version": 3,
  "name": "Quiet Field",
  "version": "0.1.0",
  "description": "Every new tab becomes a calm color field in the spirit of Rothko.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "optional_permissions": ["geolocation"],
  "optional_host_permissions": [
    "https://api.open-meteo.com/*",
    "https://api.bigdatacloud.net/*"
  ]
}
